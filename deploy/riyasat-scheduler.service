[Unit]
Description=Riyasat daily charge generation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/apps/riyasat/deploy/run-scheduler.py
TimeoutStartSec=360
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
